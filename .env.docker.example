# Exact browser origin(s), comma-separated. Do not use *.
ATHLETELENS_CORS_ORIGINS=https://your-athletelens.vercel.app

# Local Compose default. For Supabase, replace with the postgresql+psycopg URL below.
DATABASE_URL=sqlite:////data/assessments.sqlite3
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<url-encoded-password>@<pooler-host>:5432/postgres?sslmode=require

# Host directory mounted into the container at /data. Keep it on persistent storage.
ATHLETELENS_DATA_DIR=./backend/storage
API_PORT=8000
ATHLETELENS_MAX_UPLOAD_SIZE_BYTES=104857600
